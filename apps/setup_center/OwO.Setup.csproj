<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>OwO_Settings</RootNamespace>
    <AssemblyName>OwO.Setup</AssemblyName>
    <!-- WinUI otherwise derives lazy resource lookup from the EXE name.
         Release naming and browser download suffixes must not change it. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <ApplicationManifest>../settings_center/app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <Version>0.2.5</Version>
    <ApplicationIcon>../settings_center/Assets/AppIcon.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../settings_center/SetupPage.cs" Link="SetupPage.cs" />
    <Compile Include="../settings_center/SetupPrerequisites.cs" Link="SetupPrerequisites.cs" />
    <Compile Include="../settings_center/InstallerProcessRunner.cs" Link="InstallerProcessRunner.cs" />
    <Compile Include="../settings_center/InstallerPayload.cs" Link="InstallerPayload.cs" />
    <Content Include="../settings_center/Assets/**" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="$(OwOSetupPayload)" LogicalName="OwO.Setup.Payload.zip" Condition="Exists('$(OwOSetupPayload)')" />
    <EmbeddedResource Include="$(OwOSetupPayloadHash)" LogicalName="OwO.Setup.Payload.sha256" Condition="Exists('$(OwOSetupPayloadHash)')" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.3" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.3.1" />
  </ItemGroup>
  <Target Name="RequireInstallerPayload" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(OwOSetupPayload)') or !Exists('$(OwOSetupPayloadHash)')" Text="Use scripts/package_setup.ps1 to provide the verified installer payload." />
  </Target>
</Project>
