{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload",
    "signature"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ic_version",
        "capsule_id",
        "issuer",
        "audience",
        "binding",
        "origin",
        "origin_request_sha256",
        "prompt_sha256",
        "freshness",
        "nonce",
        "scope"
      ],
      "properties": {
        "ic_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "const": 1
        },
        "capsule_id": {
          "type": "string",
          "pattern": "^(?!0+$)[0-9a-f]{32}$"
        },
        "issuer": {
          "type": "string",
          "const": "owo-intent-gateway"
        },
        "audience": {
          "type": "string",
          "const": "owo-daemon-expression"
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_id",
            "request_id",
            "task_revision"
          ],
          "properties": {
            "session_id": {
              "type": "string",
              "pattern": "^(?!0+$)[0-9a-f]{32}$"
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "task_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "context_id",
            "connector_pid",
            "process_created_at_hex",
            "executable_sha256",
            "selection_sha256",
            "application_metadata"
          ],
          "properties": {
            "source": {
              "type": "string",
              "const": "ime"
            },
            "context_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "connector_pid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "process_created_at_hex": {
              "type": "string",
              "pattern": "^(?!0+$)[0-9a-f]{16}$"
            },
            "executable_sha256": {
              "type": "string",
              "pattern": "^(?!0+$)[0-9a-f]{64}$"
            },
            "selection_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "application_metadata": {
              "type": "string",
              "const": "connector_claim"
            }
          }
        },
        "origin_request_sha256": {
          "type": "string",
          "pattern": "^(?!0+$)[0-9a-f]{64}$"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^(?!0+$)[0-9a-f]{64}$"
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issued_at_ms",
            "ttl_ms"
          ],
          "properties": {
            "issued_at_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "ttl_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120000
            }
          }
        },
        "nonce": {
          "type": "string",
          "pattern": "^(?!0+$)[0-9a-f]{64}$"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "const": "expression_only"
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "key_id",
        "value"
      ],
      "properties": {
        "alg": {
          "type": "string",
          "const": "HMAC-SHA256"
        },
        "key_id": {
          "type": "string",
          "const": "gateway-expression-v1"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExpressionOriginCapsule"
}
