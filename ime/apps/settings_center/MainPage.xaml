<?xml version='1.0' encoding='UTF-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OwO_Settings.MainPage" PreviewKeyDown="Page_KeyDown" PreviewKeyUp="Page_KeyUp">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SettingsContentBackgroundBrush" Color="#d1ddec"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SettingsContentBackgroundBrush" Color="#1A2032"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SettingsContentBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Fit the switch and state label instead of reserving the default minimum width. -->
            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="OnContent" Value="开"/>
                <Setter Property="OffContent" Value="关"/>
            </Style>
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,12,8,12"/>
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,12,0,4"/>
            </Style>
            <Style x:Key="SettingTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>
    <Grid x:Name="PageRoot" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Global search belongs to the page shell, not to any individual settings section. -->
        <Grid x:Name="GlobalSearchArea" Grid.Row="0" Margin="16,16,16,10">
            <AutoSuggestBox x:Name="SettingsSearchBox" PlaceholderText="查找设置" QueryIcon="Find" TextChanged="SettingsSearchBox_TextChanged" SuggestionChosen="SettingsSearchBox_SuggestionChosen" QuerySubmitted="SettingsSearchBox_QuerySubmitted" HorizontalAlignment="Stretch" MaxWidth="720"/>
        </Grid>
        <NavigationView Grid.Row="1" x:Name="SettingsNavigation" PaneDisplayMode="Auto" OpenPaneLength="260" CompactPaneLength="48" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" AlwaysShowHeader="False" SelectionChanged="SettingsNavigation_SelectionChanged" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <FontIcon Glyph=""
                            FontSize="22"
                            VerticalAlignment="Center"/>

                    <Button Click="GeneralSettings_Click" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="打开通用设置">
                        <TextBlock Text="OwO 输入法"
                            FontSize="20"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GeneralNavigationItem" Content="通用设置" Tag="general">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SchemeNavigationItem" Content="输入方案" Tag="schemes" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph=""/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CandidateNavigationItem" Content="候选与输入" Tag="candidates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph=""/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="IntelligenceNavigationItem" Content="学习与排序" Tag="intelligence">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph=""/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ShortcutNavigationItem" Content="快捷键" Tag="shortcuts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph=""/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PluginNavigationItem" Content="插件" Tag="plugins">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph=""/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <TextBlock Text="OwO 0.2.3" Margin="16,8,8,16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </NavigationView.PaneFooter>
            <Grid Background="{ThemeResource SettingsContentBackgroundBrush}" x:Name="MainContentRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="ResponsiveLayoutStates">
                        <VisualState x:Name="CompactLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="PageHeaderArea.Margin" Value="16,6,16,12"/>
                                <Setter Target="GeneralContentArea.Margin" Value="16,0,16,20"/>
                                <Setter Target="ShortcutContentArea.Margin" Value="16,0,16,20"/>
                                <Setter Target="PluginContentArea.Margin" Value="16,0,16,20"/>
                                <Setter Target="PluginConfigContentArea.Margin" Value="16,0,16,20"/>
                                <Setter Target="FooterContentArea.Margin" Value="16,10"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="RegularLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="720"/>
                            </VisualState.StateTriggers>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid x:Name="PageHeaderArea" Margin="32,6,32,16" Grid.Row="0">
                    <StackPanel x:Name="PageHeaderContent" Spacing="4" HorizontalAlignment="Stretch" MaxWidth="960">
                        <TextBlock x:Name="CurrentPageTitle" Text="输入方案" Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBlock x:Name="CurrentPageDescription" Text="选择编码方案并查看当前方案能力" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="GeneralSettingsPage" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="GeneralContentArea" Margin="32,0,32,24">
                            <StackPanel Margin="0" Spacing="8" HorizontalAlignment="Stretch" MaxWidth="960">
                                <TextBlock x:Name="InputSchemeSectionTitle" Text="当前输入方案" Style="{StaticResource SectionTitleStyle}"/>
                                <Border x:Name="InputSchemeCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="输入方案" Style="{StaticResource SettingTitleStyle}"/>
                                            <TextBlock x:Name="InputSchemeDescription" Text="选择用于解释预编辑编码的输入方案。" Style="{StaticResource SettingDescriptionStyle}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="InputScheme" Grid.Column="1" MinWidth="200" SelectedValuePath="Id" DisplayMemberPath="Name" VerticalAlignment="Center" SelectionChanged="InputScheme_SelectionChanged"/>
                                    </Grid>
                                </Border>
                                <InfoBar x:Name="InputSchemeCapabilities" IsOpen="True" IsClosable="False" Severity="Informational" Message="正在读取输入方案能力。"/>
                                <Button x:Name="DiscoverSchemesButton" Content="发现已授权插件输入方案" Click="DiscoverSchemes_Click"/>
                                <TextBlock x:Name="CandidateSectionTitle" Text="候选显示与组合" Style="{StaticResource SectionTitleStyle}"/>
                                <Border x:Name="CandidatePageSizeCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="每页候选数" Style="{StaticResource SettingTitleStyle}"/>
                                            <TextBlock Text="控制候选窗口每页显示的项目数量。" Style="{StaticResource SettingDescriptionStyle}"/>
                                        </StackPanel>
                                        <NumberBox x:Name="CandidatePageSize" Grid.Column="1" Minimum="1" Maximum="9" SpinButtonPlacementMode="Inline" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="CandidateWrapLengthCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="候选词换行长度" Style="{StaticResource SettingTitleStyle}"/>
                                            <TextBlock Text="过长候选达到此字符数后自动换行。" Style="{StaticResource SettingDescriptionStyle}"/>
                                        </StackPanel>
                                        <NumberBox x:Name="CandidateWrapLength" Grid.Column="1" Minimum="4" Maximum="64" SpinButtonPlacementMode="Inline" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="CandidatePartitionCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="候选分区" Style="{StaticResource SettingTitleStyle}"/>
                                            <TextBlock Text="平衡词语候选与首字候选的屏内位置。" Style="{StaticResource SettingDescriptionStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="CandidatePartition" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="CandidateImmediateCommitCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="候选词即时上屏" Style="{StaticResource SettingTitleStyle}"/>
                                            <TextBlock Text="关闭后，短候选先暂存在编码预览中，确认完整组合后再上屏。" Style="{StaticResource SettingDescriptionStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="CandidateImmediateCommit" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="FocusLossCommitCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="失焦保护" Style="{StaticResource SettingTitleStyle}"/>
                                            <TextBlock Text="候选框意外关闭且仍有输入时，尝试将预览内容直接上屏。" Style="{StaticResource SettingDescriptionStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="FocusLossCommit" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="ChinesePunctuationCard" Style="{StaticResource SettingsCardStyle}" Tapped="ChinesePunctuationCard_Tapped">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Click="OpenChinesePunctuation_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="打开中文标点设置">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="中文标点" Style="{StaticResource SettingTitleStyle}"/>
                                                <TextBlock Text="控制中文标点总开关，点击配置各类标点。" Style="{StaticResource SettingDescriptionStyle}"/>
                                            </StackPanel>
                                        </Button>
                                        <ToggleSwitch x:Name="ChinesePunctuation" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center" Toggled="ChinesePunctuation_Toggled" AutomationProperties.Name="中文标点总开关"/>
                                        <Button Grid.Column="2" Click="OpenChinesePunctuation_Click" Background="Transparent" BorderThickness="0" Padding="8" VerticalAlignment="Center" AutomationProperties.Name="进入中文标点设置">
                                            <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="LearningSectionTitle" Text="词频与智能排序" Style="{StaticResource SectionTitleStyle}"/>
                                <Border x:Name="UserLearningCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="用户词频学习" Style="{StaticResource SettingTitleStyle}"/>
                                            <TextBlock Text="学习已上屏的候选与组合词，并加入本机用户词库。" Style="{StaticResource SettingDescriptionStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="UserLearning" Grid.Column="1" VerticalAlignment="Center" Toggled="DependentSetting_Toggled"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="LearningSensitivityCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="词频学习灵敏度" Style="{StaticResource SettingTitleStyle}"/>
                                            <TextBlock Text="数值越高，最近选择对候选顺序的影响越明显。" Style="{StaticResource SettingDescriptionStyle}"/>
                                        </StackPanel>
                                        <Grid Grid.Column="1" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Slider x:Name="UserLearningSensitivity" Grid.Column="1" Minimum="1" Maximum="10" Value="10" StepFrequency="1" TickFrequency="1" SnapsTo="StepValues" IsThumbToolTipEnabled="True" ValueChanged="UserLearningSensitivity_ValueChanged"/>
                                            <TextBlock x:Name="UserLearningSensitivityValue" Grid.Column="2" Text="10" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border x:Name="UserCompletionCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="用户词拼音补全" Style="{StaticResource SettingTitleStyle}"/>
                                            <TextBlock Text="仅全拼方案：从拼音前缀补全本机用户词；完整编码仍可独立匹配。" Style="{StaticResource SettingDescriptionStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="UserCompletion" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center" Toggled="DependentSetting_Toggled"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="UserCompletionRangeCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="最多补全后续音节" Style="{StaticResource SettingTitleStyle}"/>
                                            <TextBlock Text="用户词拼音补全的范围：0 仅补完当前音节；数值越大，越早显示较长的用户词（0–8，默认 0）。" Style="{StaticResource SettingDescriptionStyle}"/>
                                        </StackPanel>
                                        <NumberBox x:Name="UserCompletionRange" Grid.Column="1" Minimum="0" Maximum="8" Value="0" SpinButtonPlacementMode="Inline" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="ModelRankingCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="智能排序（本地自适应）" Style="{StaticResource SettingTitleStyle}"/>
                                            <TextBlock Text="结合最近上屏上下文重排候选，不上传输入数据。" Style="{StaticResource SettingDescriptionStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ModelRanking" Grid.Column="1" VerticalAlignment="Center" Toggled="DependentSetting_Toggled"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="ModelTimeoutCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="外部模型预算" Style="{StaticResource SettingTitleStyle}"/>
                                            <TextBlock Text="智能排序单次允许使用的最长时间（毫秒）。" Style="{StaticResource SettingDescriptionStyle}"/>
                                        </StackPanel>
                                        <NumberBox x:Name="ModelTimeout" Grid.Column="1" Minimum="5" Maximum="500" SpinButtonPlacementMode="Inline" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="AltCodeSectionTitle" Text="Alt 数字符号预览" Style="{StaticResource SectionTitleStyle}"/>
                                <Border x:Name="AltCodePreviewCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="显示符号预览" Style="{StaticResource SettingTitleStyle}"/>
                                            <TextBlock Text="按住 Alt 输入小键盘数字时显示代码和结果。" Style="{StaticResource SettingDescriptionStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AltCodePreview" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center" Toggled="DependentSetting_Toggled"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="AltCodePreviewPageSizeCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="符号预览每页项数" Style="{StaticResource SettingTitleStyle}"/>
                                            <TextBlock Text="控制一页可见的符号代码数量。" Style="{StaticResource SettingDescriptionStyle}"/>
                                        </StackPanel>
                                        <NumberBox x:Name="AltCodePreviewPageSize" Grid.Column="1" Minimum="2" Maximum="10" SpinButtonPlacementMode="Inline" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="AltCodePreviewWheelCard" Style="{StaticResource SettingsCardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="鼠标滚轮翻页" Style="{StaticResource SettingTitleStyle}"/>
                                            <TextBlock Text="在符号预览框上使用滚轮浏览更多结果。" Style="{StaticResource SettingDescriptionStyle}"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AltCodePreviewWheel" Grid.Column="1" OnContent="开" OffContent="关" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <ScrollViewer x:Name="ShortcutSettingsPage" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="ShortcutContentArea" Margin="32,0,32,24">
                            <ContentControl x:Name="ShortcutSection" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MaxWidth="960">
                                <StackPanel Margin="0" Spacing="8" HorizontalAlignment="Stretch">
                                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="每项可绑定多种方案。点击快捷键按钮后按下新组合；使用加号添加，减号删除。"/>
                                    <Border x:Name="PunctuationShortcutCard" Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="切换中文标点" Style="{StaticResource SettingTitleStyle}"/>
                                                    <TextBlock Text="打开或关闭中文标点转换。" Style="{StaticResource SettingDescriptionStyle}"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="PunctuationShortcutEnabled" Grid.Column="1"/>
                                                <Button Grid.Column="2" Content="＋" Tag="punctuation" Click="AddShortcutButton_Click"/>
                                            </Grid>
                                            <StackPanel x:Name="PunctuationShortcutBindings" Spacing="8"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="CorrectionShortcutCard" Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="切换输入纠错" Style="{StaticResource SettingTitleStyle}"/>
                                                    <TextBlock Text="临时切换全拼的严格输入和纠错模式；其他方案不使用。" Style="{StaticResource SettingDescriptionStyle}"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="CorrectionShortcutEnabled" Grid.Column="1"/>
                                                <Button Grid.Column="2" Content="＋" Tag="correction" Click="AddShortcutButton_Click"/>
                                            </Grid>
                                            <StackPanel x:Name="CorrectionShortcutBindings" Spacing="8"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="LanguageShortcutCard" Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="切换中 / 英文输入" Style="{StaticResource SettingTitleStyle}"/>
                                                    <TextBlock Text="切换输入语言模式。" Style="{StaticResource SettingDescriptionStyle}"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="LanguageShortcutEnabled" Grid.Column="1"/>
                                                <Button Grid.Column="2" Content="＋" Tag="language" Click="AddShortcutButton_Click"/>
                                            </Grid>
                                            <StackPanel x:Name="LanguageShortcutBindings" Spacing="8"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="RawInputShortcutCard" Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="输入编码原样上屏" Style="{StaticResource SettingTitleStyle}"/>
                                                    <TextBlock Text="直接输出当前预编辑编码。" Style="{StaticResource SettingDescriptionStyle}"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="RawInputShortcutEnabled" Grid.Column="1"/>
                                                <Button Grid.Column="2" Content="＋" Tag="raw" Click="AddShortcutButton_Click"/>
                                            </Grid>
                                            <StackPanel x:Name="RawInputShortcutBindings" Spacing="8"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="CursorLeftShortcutCard" Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="预编辑光标左移" Style="{StaticResource SettingTitleStyle}"/>
                                                    <TextBlock Text="向左移动输入编码光标。" Style="{StaticResource SettingDescriptionStyle}"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="CursorLeftShortcutEnabled" Grid.Column="1"/>
                                                <Button Grid.Column="2" Content="＋" Tag="cursor-left" Click="AddShortcutButton_Click"/>
                                            </Grid>
                                            <StackPanel x:Name="CursorLeftShortcutBindings" Spacing="8"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="CursorRightShortcutCard" Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="预编辑光标右移" Style="{StaticResource SettingTitleStyle}"/>
                                                    <TextBlock Text="向右移动输入编码光标。" Style="{StaticResource SettingDescriptionStyle}"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="CursorRightShortcutEnabled" Grid.Column="1"/>
                                                <Button Grid.Column="2" Content="＋" Tag="cursor-right" Click="AddShortcutButton_Click"/>
                                            </Grid>
                                            <StackPanel x:Name="CursorRightShortcutBindings" Spacing="8"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="PreviousPageShortcutCard" Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="候选词上一页" Style="{StaticResource SettingTitleStyle}"/>
                                                    <TextBlock Text="查看前一页候选词。" Style="{StaticResource SettingDescriptionStyle}"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="PreviousPageShortcutEnabled" Grid.Column="1"/>
                                                <Button Grid.Column="2" Content="＋" Tag="previous-page" Click="AddShortcutButton_Click"/>
                                            </Grid>
                                            <StackPanel x:Name="PreviousPageShortcutBindings" Spacing="8"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="NextPageShortcutCard" Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="候选词下一页" Style="{StaticResource SettingTitleStyle}"/>
                                                    <TextBlock Text="查看后一页候选词。" Style="{StaticResource SettingDescriptionStyle}"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="NextPageShortcutEnabled" Grid.Column="1"/>
                                                <Button Grid.Column="2" Content="＋" Tag="next-page" Click="AddShortcutButton_Click"/>
                                            </Grid>
                                            <StackPanel x:Name="NextPageShortcutBindings" Spacing="8"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="TextNavigationShortcutCard" Style="{StaticResource SettingsCardStyle}">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="文本区光标移动" Style="{StaticResource SettingTitleStyle}"/>
                                                    <TextBlock Text="输入编码时移动应用文本区光标，默认使用 Shift＋方向键。" Style="{StaticResource SettingDescriptionStyle}"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="TextNavigationShortcutEnabled" Grid.Column="1"/>
                                                <Button Grid.Column="2" Content="＋" Tag="text-navigation" Click="AddShortcutButton_Click"/>
                                            </Grid>
                                            <StackPanel x:Name="TextNavigationShortcutBindings" Spacing="8"/>
                                            <Grid Margin="16,4,0,0" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="选中途经文本" Style="{StaticResource SettingTitleStyle}"/>
                                                    <TextBlock Text="关闭时只移动光标；开启时同时扩展文本选择。" Style="{StaticResource SettingDescriptionStyle}"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="TextNavigationSelectEnabled" Grid.Column="1" IsOn="False"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ContentControl>
                        </Grid>
                    </ScrollViewer>
                    <ScrollViewer x:Name="PluginSettingsPage" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="PluginContentArea" Margin="32,0,32,24">
                            <ContentControl x:Name="PluginSection" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MaxWidth="960">
                                <StackPanel Margin="0" Spacing="10" HorizontalAlignment="Stretch">
                                    <Border Style="{StaticResource SettingsCardStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="安装插件" Style="{StaticResource SettingTitleStyle}"/>
                                                <TextBlock Text="支持 .owopkg、ZIP 和文件夹。高风险插件需要逐包授权。" Style="{StaticResource SettingDescriptionStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="PluginInstallButton" Content="安装压缩包" Click="PluginInstallButton_Click"/>
                                                <Button x:Name="PluginInstallFolderButton" Content="安装文件夹" Click="PluginInstallFolderButton_Click"/>
                                                <Button x:Name="PluginReloadButton" Content="刷新" Click="PluginReloadButton_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Message="第三方、未验证或高权限插件必须先阅读风险说明并对精确包单独授权。"/>
                                    <TextBlock x:Name="NoPlugins" Text="尚未安装有效插件版本。" Margin="4,12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ItemsControl x:Name="PluginVersions">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,8">
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource SettingTitleStyle}"/>
                                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Button Content="设置" Tag="{Binding}" Click="PluginVersionSettings_Click"/>
                                                            <Button Content="{Binding ActionLabel}" Tag="{Binding}" Click="PluginVersionAction_Click"/>
                                                            <Button Content="撤销权限" Tag="{Binding}" IsEnabled="{Binding CanRevoke}" Click="PluginVersionRevoke_Click"/>
                                                            <Button Content="卸载" Tag="{Binding}" IsEnabled="{Binding CanUninstall}" Click="PluginVersionUninstall_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="恢复与维护" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock x:Name="NoRecovery" Text="未发现需要审计的恢复项。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ItemsControl x:Name="RecoveryItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,8">
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="3">
                                                            <TextBlock Text="{Binding Title}"/>
                                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{Binding ActionLabel}" Tag="{Binding}" IsEnabled="{Binding CanApply}" Click="RecoveryAction_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="PluginPath" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </ContentControl>
                        </Grid>
                    </ScrollViewer>
                    <ScrollViewer x:Name="GeneralPreferencesPage" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,0,32,24" Spacing="8" MaxWidth="960" HorizontalAlignment="Stretch">
                            <Border x:Name="AutoSaveCard" Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="自动保存设置" Style="{StaticResource SettingTitleStyle}"/>
                                        <TextBlock Text="自动保存输入、快捷键、标点及插件配置。关闭后使用保存按钮；此开关立即保存。" Style="{StaticResource SettingDescriptionStyle}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutoSaveSettings" Grid.Column="1" Toggled="AutoSaveSettings_Toggled" AutomationProperties.Name="自动保存设置"/>
                                </Grid>
                            </Border>
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="连续调整会合并为一次保存。无效配置不会覆盖已保存内容；安装、启用插件及权限授权仍需明确操作。"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="ChinesePunctuationPage" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="32,0,32,24" Spacing="8" MaxWidth="960" HorizontalAlignment="Stretch">
                            <Button Content="返回候选与输入" Click="ChinesePunctuationBack_Click"/>
                            <InfoBar x:Name="ChinesePunctuationNotice" IsOpen="True" IsClosable="False" Severity="Informational"/>
                            <StackPanel x:Name="ChinesePunctuationFields" Spacing="8"/>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="PluginConfigPage" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="PluginConfigContentArea" Margin="32,0,32,24">
                            <StackPanel Margin="0" Spacing="10" HorizontalAlignment="Stretch" MaxWidth="960">
                                <InfoBar x:Name="PluginConfigNotice" IsOpen="True" IsClosable="False" Severity="Informational"/>
                                <StackPanel x:Name="PluginConfigFields" Spacing="8"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="PluginConfigSaveButton" Content="保存插件设置" Click="PluginConfigSaveButton_Click"/>
                                    <Button x:Name="PluginConfigResetButton" Content="恢复默认" Click="PluginConfigResetButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
                <Border Grid.Row="2" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0" x:Name="FooterHost">
                    <Grid x:Name="FooterContentArea" Margin="32,10">
                        <Grid ColumnSpacing="12" HorizontalAlignment="Stretch" MaxWidth="960">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SaveButton" Content="保存" Click="SaveButton_Click"/>
                            <Button x:Name="ReloadButton" Grid.Column="1" Content="重新加载" Click="ReloadButton_Click"/>
                            <Button x:Name="ResetPageButton" Grid.Column="2" Content="重置本页" Click="ResetPageButton_Click"/>
                            <InfoBar x:Name="Status" Grid.Column="3" IsOpen="True" Severity="Informational" Title="正在加载配置" IsClosable="False" HorizontalAlignment="Stretch"/>
                            <TextBlock x:Name="ConfigPath" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
