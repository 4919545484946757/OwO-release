{
  "schema_version": 1,
  "failure_classes": ["permission-denied", "timeout", "unapproved-side-effect", "wrong-output"],
  "expected_side_effects": ["read:inputs/**", "write:out/**", "desktop:ui-observe", "desktop:ui-act"],
  "repetitions": 3,
  "id": "desktop-file-explorer-search",
  "category": "desktop",
  "title": "文件资源管理器搜索文件",
  "instruction": "必须在真实 Windows 桌面环境中执行；模拟器或离屏渲染结果不得计入。用真实文件资源管理器在 inputs/search-root/ 中搜索包含“report”的文件，把命中文件和搜索过程写入 out/desktop-report.md。报告必须包含“## 操作步骤”“## 验证”，并注明真实 Windows 桌面环境。",
  "inputs": [
    {
      "path": "inputs/search-root/report-q1.txt",
      "content": "Q1 report\n"
    },
    {
      "path": "inputs/search-root/report-q2.txt",
      "content": "Q2 report\n"
    },
    {
      "path": "inputs/search-root/notes.txt",
      "content": "notes\n"
    }
  ],
  "allow_read": ["inputs/**"],
  "allow_write": ["out/**"],
  "allow_commands": [],
  "expected_artifacts": ["out/desktop-report.md"],
  "checkers": [
    { "type": "regex", "path": "out/desktop-report.md", "pattern": "^## 操作步骤" },
    { "type": "regex", "path": "out/desktop-report.md", "pattern": "^## 验证" },
    { "type": "contains", "path": "out/desktop-report.md", "text": "真实 Windows 桌面环境" },
    { "type": "contains", "path": "out/desktop-report.md", "text": "文件资源管理器" },
    { "type": "contains", "path": "out/desktop-report.md", "text": "report-q1.txt" },
    { "type": "contains", "path": "out/desktop-report.md", "text": "report-q2.txt" },
    { "type": "contains", "path": "out/desktop-report.md", "text": "2 个" },
    { "type": "not_contains", "path": "out/desktop-report.md", "text": "TBD" },
    { "type": "line_count_min", "path": "out/desktop-report.md", "min_lines": 8 }
  ],
  "timeout_secs": 900,
  "max_model_calls": 64,
  "reference_outputs": {
    "out/desktop-report.md": "# 桌面操作报告\n\n## 应用\n\n- 文件资源管理器（Windows 11）\n\n## 操作步骤\n\n- 在真实 Windows 桌面环境中打开 inputs/search-root/。\n- 在搜索框输入 report 并等待结果。\n- 记录命中的 report-q1.txt 与 report-q2.txt。\n\n## 验证\n\n- 搜索结果共 2 个文件，均包含 report。\n- notes.txt 未出现在结果中，与预期一致。\n"
  }
}
