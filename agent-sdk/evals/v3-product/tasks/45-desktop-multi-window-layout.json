{
  "schema_version": 1,
  "failure_classes": ["permission-denied", "timeout", "unapproved-side-effect", "wrong-output"],
  "expected_side_effects": ["read:inputs/**", "write:out/**", "desktop:ui-observe", "desktop:ui-act"],
  "repetitions": 3,
  "id": "desktop-multi-window-layout",
  "category": "desktop",
  "title": "多窗口并排与跨窗口核对",
  "instruction": "必须在真实 Windows 桌面环境中执行；模拟器或离屏渲染结果不得计入。把真实浏览器、文件资源管理器和记事本三个窗口并排显示，核对 inputs/layout.txt 中的三行内容，并把窗口布局与核对结果写入 out/desktop-report.md。报告必须包含“## 操作步骤”“## 验证”，并注明真实 Windows 桌面环境。",
  "inputs": [
    {
      "path": "inputs/layout.txt",
      "content": "浏览器：MAIN\n文件资源管理器：FILES\n记事本：NOTES\n"
    }
  ],
  "allow_read": ["inputs/**"],
  "allow_write": ["out/**"],
  "allow_commands": [],
  "expected_artifacts": ["out/desktop-report.md"],
  "checkers": [
    { "type": "regex", "path": "out/desktop-report.md", "pattern": "^## 操作步骤" },
    { "type": "regex", "path": "out/desktop-report.md", "pattern": "^## 验证" },
    { "type": "contains", "path": "out/desktop-report.md", "text": "真实 Windows 桌面环境" },
    { "type": "contains", "path": "out/desktop-report.md", "text": "浏览器" },
    { "type": "contains", "path": "out/desktop-report.md", "text": "文件资源管理器" },
    { "type": "contains", "path": "out/desktop-report.md", "text": "记事本" },
    { "type": "contains", "path": "out/desktop-report.md", "text": "MAIN" },
    { "type": "contains", "path": "out/desktop-report.md", "text": "NOTES" },
    { "type": "not_contains", "path": "out/desktop-report.md", "text": "TBD" },
    { "type": "line_count_min", "path": "out/desktop-report.md", "min_lines": 8 }
  ],
  "timeout_secs": 900,
  "max_model_calls": 64,
  "reference_outputs": {
    "out/desktop-report.md": "# 桌面操作报告\n\n## 应用\n\n- 浏览器（Microsoft Edge）\n- 文件资源管理器（Windows 11）\n- 记事本（Windows 11）\n\n## 操作步骤\n\n- 在真实 Windows 桌面环境中打开三个应用窗口。\n- 使用窗口贴靠把三窗口并排，浏览器显示 MAIN，文件资源管理器显示 FILES，记事本显示 NOTES。\n\n## 验证\n\n- 三个窗口同时可见，标题与布局文件一致。\n- 逐一核对 MAIN、FILES、NOTES，没有窗口被最小化。\n"
  }
}
