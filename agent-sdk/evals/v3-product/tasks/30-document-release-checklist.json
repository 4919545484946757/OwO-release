{
  "schema_version": 1,
  "failure_classes": [
    "wrong-output",
    "missing-artifact",
    "timeout"
  ],
  "expected_side_effects": [
    "read:inputs/**",
    "write:out/**"
  ],
  "repetitions": 3,
  "id": "document-release-checklist",
  "category": "document",
  "title": "发布清单整理",
  "instruction": "读取 inputs/checklist.txt，把事项按“发布前”和“发布后”分组写入 out/checklist.md。已完成的事项用 [x]，未完成的事项用 [ ]；备份和依赖更新视为已完成，通知团队和验证回滚视为未完成。不得使用 TBD。",
  "inputs": [
    {
      "path": "inputs/checklist.txt",
      "content": "- 完成备份\n- 更新依赖\n- 通知团队\n- 验证回滚\n"
    }
  ],
  "allow_read": [
    "inputs/**"
  ],
  "allow_write": [
    "out/**"
  ],
  "allow_commands": [],
  "expected_artifacts": [
    "out/checklist.md"
  ],
  "checkers": [
    {
      "type": "regex",
      "path": "out/checklist.md",
      "pattern": "^## 发布前"
    },
    {
      "type": "regex",
      "path": "out/checklist.md",
      "pattern": "^## 发布后"
    },
    {
      "type": "contains",
      "path": "out/checklist.md",
      "text": "- [x] 完成备份"
    },
    {
      "type": "contains",
      "path": "out/checklist.md",
      "text": "- [x] 更新依赖"
    },
    {
      "type": "contains",
      "path": "out/checklist.md",
      "text": "- [ ] 通知团队"
    },
    {
      "type": "contains",
      "path": "out/checklist.md",
      "text": "- [ ] 验证回滚"
    },
    {
      "type": "not_contains",
      "path": "out/checklist.md",
      "text": "TBD"
    },
    {
      "type": "line_count_min",
      "path": "out/checklist.md",
      "min_lines": 6
    }
  ],
  "timeout_secs": 900,
  "max_model_calls": 64,
  "reference_outputs": {
    "out/checklist.md": "# 发布清单\n\n## 说明\n\n- [x] 表示已完成，[ ] 表示未完成。\n\n## 发布前\n\n- [x] 完成备份\n- [x] 更新依赖\n\n## 发布后\n\n- [ ] 通知团队\n- [ ] 验证回滚\n"
  }
}
