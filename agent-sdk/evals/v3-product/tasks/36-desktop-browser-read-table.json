{
  "schema_version": 1,
  "failure_classes": ["permission-denied", "timeout", "unapproved-side-effect", "wrong-output"],
  "expected_side_effects": ["read:inputs/**", "write:out/**", "desktop:ui-observe", "desktop:ui-act"],
  "repetitions": 3,
  "id": "desktop-browser-read-table",
  "category": "desktop",
  "title": "浏览器读取页面表格并记录",
  "instruction": "必须在真实 Windows 桌面环境中执行；模拟器或离屏渲染结果不得计入。用真实浏览器打开本地页面 inputs/sales.html，读取表格三行数据，把读取结果和核对过程写入 out/desktop-report.md。报告必须包含“## 操作步骤”“## 验证”，并注明真实 Windows 桌面环境。",
  "inputs": [
    {
      "path": "inputs/sales.html",
      "content": "<table><tr><th>region</th><th>amount</th></tr><tr><td>East</td><td>25.00</td></tr><tr><td>West</td><td>20.00</td></tr><tr><td>North</td><td>30.00</td></tr></table>\n"
    }
  ],
  "allow_read": ["inputs/**"],
  "allow_write": ["out/**"],
  "allow_commands": [],
  "expected_artifacts": ["out/desktop-report.md"],
  "checkers": [
    { "type": "regex", "path": "out/desktop-report.md", "pattern": "^## 操作步骤" },
    { "type": "regex", "path": "out/desktop-report.md", "pattern": "^## 验证" },
    { "type": "contains", "path": "out/desktop-report.md", "text": "真实 Windows 桌面环境" },
    { "type": "contains", "path": "out/desktop-report.md", "text": "浏览器" },
    { "type": "contains", "path": "out/desktop-report.md", "text": "East" },
    { "type": "contains", "path": "out/desktop-report.md", "text": "75.00" },
    { "type": "not_contains", "path": "out/desktop-report.md", "text": "TBD" },
    { "type": "line_count_min", "path": "out/desktop-report.md", "min_lines": 8 }
  ],
  "timeout_secs": 900,
  "max_model_calls": 64,
  "reference_outputs": {
    "out/desktop-report.md": "# 桌面操作报告\n\n## 应用\n\n- 浏览器（Microsoft Edge）\n\n## 操作步骤\n\n- 在真实 Windows 桌面环境中用浏览器打开 inputs/sales.html。\n- 逐行读取表格：East 25.00、West 20.00、North 30.00。\n\n## 验证\n\n- 三行金额相加为 75.00，与页面显示一致。\n- 通过可见窗口目视核对表格行数与应用标题。\n"
  }
}
