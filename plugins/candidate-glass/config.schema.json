      "type": "string",
      "title": "候选框主题",
      "description": "可跟随 Windows 应用明暗模式，或固定使用浅色、深色。",
      "enum": [
        "system",
        "light",
        "dark"
      ],
      "enumNames": [
        "跟随系统",
        "浅色",
        "深色"
      ],
      "default": "system"
    },
    "background_blur_enabled": {
      "type": "boolean",
      "title": "高斯模糊背景",
      "description": "采样候选框后方画面并进行本地高斯模糊。",
      "default": true,
      "x-page": "common"
    },
    "background_blur_radius": {
      "type": "number",
      "title": "高斯模糊半径",
      "description": "只作用于候选框下方画面；数值越大背景越柔和。",
      "default": 4,
      "minimum": 0,
      "maximum": 24,
      "multipleOf": 1,
      "x-page": "common"
    },
    "background_color": {
      "type": "string",
