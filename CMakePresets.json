{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-x86-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows-base",
      "displayName": "Windows x64 Debug"
    },
    {
      "name": "windows-developer",
      "inherits": "windows-base",
      "displayName": "Isolated Windows developer CLI",
      "cacheVariables": {
        "OWO_BUILD_DEVELOPER_TOOLS": "ON"
      }
    },
    {
      "name": "windows-release",
      "inherits": "windows-base",
      "displayName": "Windows x64 Release"
    },
    {
      "name": "windows-x86-debug",
      "inherits": "windows-x86-base",
      "displayName": "Windows x86 Debug"
    },
    {
      "name": "windows-x86-release",
      "inherits": "windows-x86-base",
      "displayName": "Windows x86 Release"
    },
    {
      "name": "windows-release-ort",
      "inherits": "windows-base",
      "displayName": "Windows x64 Release with ONNX Runtime",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OWO_ENABLE_ONNXRUNTIME": "ON",
        "OWO_ONNXRUNTIME_ROOT": "${sourceDir}/build/dependencies/onnxruntime-1.28.0/sdk"
      }
    },
    {
      "name": "windows-release-zlib",
      "inherits": "windows-base",
      "displayName": "Windows x64 Release with zlib plugin extraction",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OWO_ENABLE_ZLIB": "ON",
        "OWO_ZLIB_ROOT": "${sourceDir}/build/dependencies/zlib-1.3.2/source"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-developer",
      "configurePreset": "windows-developer",
      "configuration": "Release"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "windows-x86-debug",
      "configurePreset": "windows-x86-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-x86-release",
      "configurePreset": "windows-x86-release",
      "configuration": "Release"
    },
    {
      "name": "windows-release-ort",
      "configurePreset": "windows-release-ort",
      "configuration": "Release"
    },
    {
      "name": "windows-release-zlib",
      "configurePreset": "windows-release-zlib",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-developer",
      "configurePreset": "windows-developer",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release-ort",
      "configurePreset": "windows-release-ort",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release-zlib",
      "configurePreset": "windows-release-zlib",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
